{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Capture Mirror",
  "mainBinaryName": "Capture Mirror",
  "version": "0.3.0",
  "identifier": "com.capturemirror.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Capture Mirror",
        "url": "renderer/index.html",
        "width": 1280,
        "height": 720,
        "minWidth": 640,
        "minHeight": 360,
        "backgroundColor": "#000000",
        "visible": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=CalculateNativeWinOcclusion,MediaFoundationVideoCapture,msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-renderer-backgrounding --disable-background-timer-throttling --disable-backgrounding-occluded-windows --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' http://clip.localhost",
        "media-src": "'self' http://clip.localhost",
        "style-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
